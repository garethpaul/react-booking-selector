{
  "env": {
    "library": {
      "presets": [
        "@babel/preset-react",
        "@babel/preset-flow",
        [
          "@babel/preset-env",
          {
            "targets": {
              "browsers": "last 2 versions"
            },
            "loose": true
          }
        ]
      ],
      "plugins": [
        [
          "@babel/plugin-transform-class-properties",
          {
            "loose": true
          }
        ],
        [
          "@babel/plugin-transform-object-rest-spread",
          {
            "loose": true
          }
        ],
        [
          "babel-plugin-styled-components",
          {
            "fileName": false
          }
        ]
      ]
    },
    "esm": {
      "presets": [
        "@babel/preset-react",
        "@babel/preset-flow",
        [
          "@babel/preset-env",
          {
            "targets": {
              "browsers": "last 2 versions"
            },
            "loose": true,
            "modules": false
          }
        ]
      ],
      "plugins": [
        [
          "@babel/plugin-transform-class-properties",
          {
            "loose": true
          }
        ],
        [
          "@babel/plugin-transform-object-rest-spread",
          {
            "loose": true
          }
        ],
        [
          "babel-plugin-styled-components",
          {
            "fileName": false
          }
        ]
      ]
    },
    "parcel": {
      "presets": [
        "@babel/preset-flow"
      ],
      "plugins": [
        [
          "babel-plugin-styled-components",
          {
            "fileName": false
          }
        ]
      ]
    },
    "test": {
      "presets": [
        "@babel/preset-react",
        "@babel/preset-flow",
        [
          "@babel/preset-env",
          {
            "targets": {
              "browsers": "last 2 versions"
            },
            "loose": true
          }
        ]
      ],
      "plugins": [
        [
          "@babel/plugin-transform-class-properties",
          {
            "loose": true
          }
        ],
        [
          "@babel/plugin-transform-object-rest-spread",
          {
            "loose": true
          }
        ],
        [
          "babel-plugin-styled-components",
          {
            "fileName": false
          }
        ]
      ]
    }
  }
}
