{
  "name": "react-booking-selector",
  "version": "1.0.2",
  "description": "A grid based booking selector.",
  "author": "Gareth Paul Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/garethpaul/react-booking-selector.git"
  },
  "keywords": [
    "react",
    "styled-components",
    "date",
    "grid"
  ],
  "main": "dist/lib/index.js",
  "targets": {
    "docs": {
      "distDir": "dist/docs",
      "publicUrl": "/",
      "includeNodeModules": true
    }
  },
  "alias": {
    "styled-components": "styled-components/dist/styled-components.browser.esm.js"
  },
  "license": "MIT",
  "scripts": {
    "prepublish": "yarn build",
    "postpublish": "yarn docs:deploy",
    "build": "yarn lib:build && yarn docs:build",
    "lint": "eslint src/**/*.{js,jsx} --quiet",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "cover": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "test": "jest",
    "lib:build": "babel src/lib -d dist/lib --extensions .js,.jsx",
    "docs:dev": "parcel src/docs/index.html --dist-dir dev/docs",
    "docs:build": "NODE_ENV=production parcel build src/docs/index.html --target docs",
    "docs:deploy": "yarn docs:build && surge dist/docs --domain react-booking-selector.surge.sh",
    "start": "yarn docs:dev"
  },
  "engines": {
    "node": ">=20.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "styled-components": ">=5.1.0 || >=6.0.0"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-flow": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.4.1",
    "babel-plugin-styled-components": "^2.3.0",
    "coveralls": "^3.0.2",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-flowtype": "^2.46.3",
    "eslint-plugin-import": "^2.11.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-prettier": "^2.6.0",
    "eslint-plugin-react": "^7.7.0",
    "flow-bin": "^0.71.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-styled-components": "^7.4.0",
    "parcel": "^2.16.4",
    "prettier": "^1.14.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "styled-components": "^6.4.2",
    "surge": "^0.20.1"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120,
    "tabWidth": 2
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ],
    "testEnvironment": "jsdom",
    "verbose": false
  }
}
